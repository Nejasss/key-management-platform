# ─────────────────────────────────────────────────────────
# Key Management Platform — Environment Variables
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit your actual .env file to Git. It is already
# listed in .gitignore.
#
# On Vercel, set these under: Project Settings -> Environment Variables
# ─────────────────────────────────────────────────────────

# Neon PostgreSQL connection string.
# Get this from your Neon project dashboard -> Connection Details.
# Must be the pooled connection string for serverless compatibility.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign/encrypt sensitive server-side values.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# The public URL your app is deployed at (used for links/redirects).
APP_URL=http://localhost:3000

# Email of the admin account created by `npm run db:seed`.
ADMIN_EMAIL=admin@example.com

# Password for the admin account created by `npm run db:seed`.
# This is ONLY read once, at seed time, to create a hashed password in
# the database — it is never stored in plaintext and never logged.
# Use a strong, unique password (min 8 characters, longer is better).
# Remove or rotate this value after seeding if you like.
ADMIN_PASSWORD=

# Authorizes the Vercel Cron job at /api/cron/cleanup-logs (runs daily,
# see vercel.json). The cron request must send this as
# `Authorization: Bearer <CRON_SECRET>` — Vercel does this automatically
# for scheduled invocations once this var is set in your project.
# Generate one with: openssl rand -base64 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────
# /api/verify request/response encryption (optional but recommended
# for production — see README.md §10 for the full protocol and
# examples/verify-client/ for ready-to-use client code).
#
# Leave BOTH of these blank to run /api/verify in plain JSON mode
# (fine for local development). Set BOTH to require every client to
# send an AES-256-GCM encrypted, HMAC-signed request, and receive an
# encrypted, signed response back — this protects against a proxy tool
# (Fiddler/Charles/Frida) reading or rewriting the verdict on the
# client's own device, which plain HTTPS alone does not prevent.
# ─────────────────────────────────────────────────────────

# 32-byte AES-256 key, base64-encoded. Generate with:
#   openssl rand -base64 32
API_ENCRYPTION_KEY=

# Separate secret for HMAC-SHA256 request/response signing. Must be
# different from API_ENCRYPTION_KEY. Generate with:
#   openssl rand -base64 32
API_HMAC_SECRET=
